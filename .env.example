# ============================================
# Base Legal — Variáveis de Ambiente
# ============================================
# Copia para .env e preenche com valores reais

# === Base de Dados ===
DATABASE_URL=postgres://app_backend:senha@localhost:5432/buscador_juridico?sslmode=disable
USE_JSON=false

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT ===
# Gerar com: openssl rand -base64 48
JWT_SECRET=colar-aqui-um-secret-de-64-caracteres

# === Google OAuth ===
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# === Gemini AI ===
GEMINI_API_KEY=AIzaSy...

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# === Ambiente ===
AMBIENTE=development
